<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">

    <!-- APP BAR con cabecera custom -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <!-- Cabecera: título centrado + nota a la derecha + "by D4vRAM" debajo a la derecha -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <!-- Título centrado -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="NowPlayingExporterPy"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/fg_primary"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:fontFamily="@font/inter_semibold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_goneMarginTop="0dp"/>

            <!-- Icono nota musical arriba derecha alineado con el título -->
            <ImageView
                android:id="@+id/ivNote"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_music_note"
                android:alpha="0.9"
                android:contentDescription="@string/app_name"
                app:layout_constraintTop_toTopOf="@id/tvAppTitle"
                app:layout_constraintBottom_toBottomOf="@id/tvAppTitle"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- by D4vRAM debajo del título, alineado a la derecha -->
            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by D4vRAM"
                android:textSize="13sp"
                android:textColor="@color/fg_muted"
                android:letterSpacing="0.015"
                android:includeFontPadding="false"
                android:fontFamily="@font/inter"
                app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
                app:layout_constraintEnd_toEndOf="parent"
                android:paddingTop="2dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO: nada se solapa, root note fijo abajo -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Tarjeta de estado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardForegroundColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/fg_muted"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Listo para exportar"
                    android:textColor="@color/fg_primary"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pulsa Exportar para generar el CSV en Descargas."
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/rowButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Exportar"
                app:strokeColor="@color/accent"
                app:iconGravity="textStart"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Compartir"
                app:backgroundTint="@color/accent"/>
        </LinearLayout>

        <!-- Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbDedupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deduplicar (10 min)"
            android:textColor="@color/fg_primary"
            app:useMaterialThemeColors="true"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/rowButtons"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Aviso Root pegado al fondo -->
        <TextView
            android:id="@+id/tvRootNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="⚠️ Permisos de Root necesarios"
            android:textSize="12sp"
            android:textColor="@color/fg_muted"
            android:gravity="center"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Log ocupa exactamente entre checkbox y aviso -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/fg_muted"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cbDedupe"
            app:layout_constraintBottom_toTopOf="@id/tvRootNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="@color/fg_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true"/>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FAB compartir (lo muestras cuando haya CSV) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Compartir último CSV"
        android:visibility="gone"
        app:srcCompat="@android:drawable/ic_menu_share"
        app:tint="@android:color/white"
        app:backgroundTint="@color/accent"
        app:layout_anchorGravity="bottom|end"
        android:layout_margin="16dp"
        app:layout_anchor="@id/cardStatus"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
