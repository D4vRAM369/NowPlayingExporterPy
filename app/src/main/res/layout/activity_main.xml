<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header con título + subtítulo -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="NowPlayingExporterPy"
        app:subtitle="by D4vRAM"
        app:titleCentered="true"
        app:subtitleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.HeaderTitle"
        app:subtitleTextAppearance="@style/TextAppearance.HeaderSubtitle"
        android:elevation="0dp"
        app:layout_scrollFlags="scroll|enterAlways" />

    <!-- Nota musical en la esquina -->
    <ImageView
        android:id="@+id/ivNote"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.85"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_music_note" />

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="?attr/actionBarSize">

        <!-- Tarjeta de estado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardForegroundColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/fg_muted"
            app:strokeWidth="1dp">

            <LinearLayout
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvStatus"
                    android:text="Listo."
                    android:textColor="@color/fg_primary"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:text=""
                    android:textColor="@color/fg_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Exportar"
                app:strokeColor="@color/accent"
                app:iconGravity="textStart"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Compartir"
                app:backgroundTint="@color/accent"/>
        </LinearLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbDedupe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Deduplicar (10 min)"
            android:textColor="@color/fg_primary"
            app:useMaterialThemeColors="true" />

        <!-- Log -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeColor="@color/fg_muted"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvLog"
                    android:padding="16dp"
                    android:textColor="@color/fg_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>


        <TextView
            android:id="@+id/tvRootNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Permisos de Root necesarios"
            android:textSize="12sp"
            android:textColor="@color/fg_muted"
            android:gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingBottom="8dp"/>

    </LinearLayout>

    <!-- Acción flotante de compartir (aparece al tener archivo) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Compartir último CSV"
        android:visibility="gone"
        app:srcCompat="@android:drawable/ic_menu_share"
        app:tint="@android:color/white"
        app:backgroundTint="@color/accent"
        app:layout_anchorGravity="bottom|end"
        android:layout_margin="16dp"
        app:layout_anchor="@id/cardStatus"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
