<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#0F0F23"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvStatus"
        android:text="Listo."
        android:textColor="#E5E7EB"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:text=""
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnExport"
            android:text="Exportar"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="48dp"/>

        <Space android:layout_width="12dp" android:layout_height="0dp"/>

        <Button
            android:id="@+id/btnShare"
            android:text="Compartir"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <CheckBox
        android:id="@+id/cbDedupe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deduplicar (10 min)"
        android:textColor="#E5E7EB"
        android:layout_marginTop="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvLog"
            android:textColor="#E5E7EB"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Compartir último CSV"
        android:visibility="gone"
        app:srcCompat="@android:drawable/ic_menu_share"
        app:tint="@android:color/white"
        android:layout_gravity="end"
        android:layout_margin="12dp"/>
</LinearLayout>
